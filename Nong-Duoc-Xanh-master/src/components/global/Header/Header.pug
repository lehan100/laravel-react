header.header
	.header-top(class="bg-Primary-1")
		.container 
			.header-top-wrapper(class="flex items-center justify-between")
				.header-top-left(class="rem:max-w-[560px] w-full flex items-center rem:gap-[63px]")
					.header-logo(class="rem:w-[139px]")
						a(href="#" class="img-ratio ratio:pt-[55_139]") 
							+PugImg("./img/logo.svg")
					.header-top-search(class="xl:block hidden")
						form(action="") 
							.product-search-box
								input(type="text" placeholder="Bạn tìm gì...")
								button 
									<i class="fa-light fa-magnifying-glass"></i>
				.header-top-right(class="flex-1 w-full flex justify-end")
					.header-cart(class="flex items-center gap-3")
						.icon(class="text-xl text-Primary-1") 
							<i class="fa-regular fa-cart-shopping"></i>
							.cart-quantity 1
			
					.header-search 
						i.fa-regular.fa-magnifying-glass
					.header-bar 
						i.fa-solid.fa-bars
					.header-right-auth(class="xl:flex hidden items-center gap-3")
						-for(var i = 0; i < 3;i++)
							.header-auth-item(class="group")
								a(href="#") 
									.icon(class="rem:w-[32px]  [&>svg]:rem:h-[32px] transition-all") 
										img(src="./img/1.svg", alt="" class="img-svg")
