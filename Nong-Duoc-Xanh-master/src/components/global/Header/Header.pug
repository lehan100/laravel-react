.header-search-form
	.close.flex.items-center.justify-center.absolute.top-0.right-0.bg-white.text-3xl.cursor-pointer(class="w-12.5 h-12.5")
		i.fa-light.fa-xmark
	.container
		.wrap-form-search-product
			.productsearchbox
				input(type="text" placeholder="Tìm kiếm thông tin")
				button
					i.fa-light.fa-magnifying-glass
.header-menu-mobile(data-step-index="0")
	.header-title-close(class="flex items-center justify-between h-[50px] border-b border-neutral-100 gradient-primary")
		.title(class="text-white text-2xl uppercase pl-[15px]") Danh mục
		.close(class="cursor-pointer h-[50px] w-[50px] flex-center bg-Primary-#06 text-white text-4xl ")
			i.fa-light.fa-chevron-left
.mini-cart-wrapper(class="fixed top-0 right-0 w-full bg-neutral-50 h-full z-[160] px-4 py-6 flex flex-col transition-all duration-300 translate-x-full shadow-light" id="mini-cart-wrapper")
	.top.relative
		.close-mini-cart(class="w-10 h-10 flex items-center justify-center absolute left-0 top-1/2 -translate-y-1/2 group bg-Primary-1 hover:bg-Primary-Brown transition-300 cursor-pointer")
			<i class="fa-regular fa-arrow-left text-Neutral-White text-xl font-bold group-hover:text-white"></i>
		.title(class="rem:text-[28px] uppercase font-bold text-center") Giỏ hàng
	.middle(class="border-t border-t-neutral-200 mt-3 py-3 flex-1 h-full flex flex-col overflow-hidden")
		.list(class="overflow-auto")
			<p class="woocommerce-mini-cart__empty-message">No products in the cart.</p>
			.mini-cart-item
				.img 
					a(href="#" class="img-ratio")
						+PugImg()
				.content
					.remove-item
						<i class="fa-regular fa-trash-can"></i>
					.title Thực phẩm chay
					.price-wrapper 
						.quantity 1x
						.price 30.000 đ
			.mini-cart-item
				.img 
					a(href="#" class="img-ratio")
						+PugImg()
				.content
					.remove-item
						<i class="fa-regular fa-trash-can"></i>
					.title Thực phẩm chay
					.price-wrapper 
						.quantity 1x
						.price 30.000 đ
	.bottom(class="pt-3 border-t border-t-neutral-200 space-y-4")
		.cart-quantity(class="flex items-center justify-between gap-2")
			.title(class="text-xl font-bold") Số lượng
			.ctn(class="font-medium") 3 sản phẩm
		.total(class="flex items-center justify-between gap-2")
			.title(class="subheader-20 font-bold") Tổng thanh toán
			.ctn(class="font-medium") 250.000 đ
		.checkout(class="border-t border-t-neutral-200 pt-3 flex items-center justify-center")
			a.btn.btn-primary(href="#" class=" w-full") 
				span Xem giỏ hàng 
.backdrop-overlay.mini-cart-overlay(class="fixed inset-0 z-[158]")