section.home-1(class="section-40 bg-Secondary-Light-Grey")
	.container 
		.wrapper(class="flex gap-6")
			.col-left(class="rem:max-w-[1016px] w-full")
				.top(class="relative")
					.swiper 
						.swiper-wrapper 
							-for(var i = 0; i < 3; i++)
								.swiper-slide 
									.img 
										a(href="#" class="img-ratio ratio:pt-[417_1016] rounded-xl") 
											+PugImg("./img/banner.png")
					.pagination 
				.bottom(class="mt-3")
					.bottom-wrapper(class="flex rem:min-h-[203px]")
						.col-left(class="rem:max-w-[640px] w-full h-full bg-Neutral-White rounded-tl-xl rounded-bl-xl p-6")
							.list(class="grid grid-cols-2 xl:rem:gap-x-[93px] rem:gap-y-8 gap-6")
								-for(var i = 0; i < 4; i++)
									.item(class="flex gap-3")
										.icon(class="w-10") 
											a(href="#" class="img-ratio") 
												img(src="./img/3.svg", alt="")
										.content 
											h2(class="text-xl text-Primary-4 font-bold mb-2") Thuốc chính hãng
											.sub-title(class="") Đa dạng và chuyên sâu
						.col-right(class="flex-1 w-full bg-Primary-1 rounded-tr-xl rounded-br-xl p-6 relative")
							.frame-icon(class="absolute top-2/4 -translate-y-2/4 right-5 rem:w-[113px]")
								a(href="#" class="img-ratio ratio:pt-[165_113]") 
									img(src="./img/2.png", alt="")
							.wrapper(class="rem:w-[188px] flex flex-col rem:gap-[26px]")
								-for(var i = 0; i < 2; i++)
									.item 
										.icon 
											<i class="fa-regular fa-phone"></i>
										.content 
											.title Gọi mua hàng
											a(href="#") 09.6661.6664
			.col-right(class="flex-1")
				.wrapper-deal(class="flex flex-col pr-2 gap-3 overflow-y-auto rem:max-h-[631px]")
					-for(var i = 0; i < 8; i++)
						.item 
							a(href="#" class="img-ratio ratio:pt-[58.7%] rounded-xl") 
								+PugImg()
