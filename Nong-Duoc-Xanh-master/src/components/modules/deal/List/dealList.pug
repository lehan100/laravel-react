#form-register-product.form-register-product(style="display: none;" data-fancybox-modal)
	.popup-content(class="w-full relative z-50")
		h3 Đăng ký nhận thông báo
		form(action="")
			.wrap-form(class="grid grid-cols-2 gap-6") 
				.form-group.title(class="col-span-full")
					input(type="text" name="ho-va-ten" placeholder="Bộ phân bón RUSI NPK Complex 4 công thức ")
				.form-group
					input(type="email" name="email" placeholder="Họ và tên")
				.form-group
					input(type="tel" name="so-dien-thoai" placeholder="Điện thoại")
				.form-submit(class="col-span-full")
					button(class="btn btn-primary") Gửi