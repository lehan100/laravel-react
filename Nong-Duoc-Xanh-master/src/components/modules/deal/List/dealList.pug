+ProductBannerSection()
section.deal-1(class="section-40")
	.container 
		.heading(class="flex items-center gap-6")
			.icon(class="rem:w-[50px]") 
				a(href="#" class="img-ratio") 
					img(src="./img/4.svg", alt="")
			h2(class="title-40") Giải pháp cây trồng
		.wrapper(class="grid lg:grid-cols-4 md:grid-cols-2 grid-cols-1 gap-base mt-5")
			-for(var i = 0; i < 4; i++) 
				.product-item-sale 
					.img 
						a(href="#" class="img-ratio ratio:pt-[213_320] zoom-img") 
							+PugImg("./img/product-sale.png")
					.content(class="mt-5 px-5 pb-5")
						.heading
							.h3(class="text-xl text-Neutral-Black font-bold mb-2")
								a(href="#") Bộ phân bón RUSI NPK Complex 4 công thức 
							.wrapper(class="flex items-center gap-5")
								.rating(class="flex items-center gap-1")
									.icon 
										<i class="fa-solid fa-star"></i>
									span 4.8
								a.tag(href="#") Mua sỉ giá tốt
						.price 
							.price-sale 
								bdi 200.000 ₫
							.price-old 
								bdi 300.000 ₫
						.info 
							.quantity 
								span Số lượng:
								|  30 tấn
							.minimun-order 
								span Đơn hàng tối thiểu:
								|  1.000kg/khách hàng
							.status
								span Tình trạng:
								| đang mở bán
							.delivery-datey
								span Ngày giao hàng:
								|  5/01/2023
							.delivery
								span Giao hàng:
								|  toàn quốc
							.time-sale 
								span Kết thúc trong:
								.countdown(data-start="2025-08-10T12:00:00" data-end="2025-08-11T12:00:00")
									span.hours 
									span.minutes 
									span.seconds 
						.sell-line(data-sold="120" data-total="150") 
							span Đã bán 120
						a.see-now(href="#") 
							span XEM NGAY
							.icon 
								<i class="fa-regular fa-eye"></i>
		.btn-more(class="flex-center mt-5")
			a(href="" class='btn-primary btn ')
				span Xem tất cả
				.icon 
					<i class="fa-regular fa-chevron-down"></i>
