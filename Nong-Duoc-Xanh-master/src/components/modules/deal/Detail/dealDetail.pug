section.deal-detail-2(class="py-5 bg-Secondary-Light-Grey")
	.container 
		.box(class="bg-Neutral-White rounded-xl p-10")
			.deal-table(class="table-responsive") 
				table(class="w-full border-collapse max-md:overflow-x-hidden max-md:w-[520px]") 
