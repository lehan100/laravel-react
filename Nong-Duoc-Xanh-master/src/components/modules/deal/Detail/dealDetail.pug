											.title(class="font-bold") GROGREEN GEL NPK 26-26-26+TE phân bón lá nuôi trái, to lá, bung chồi, mập...
											.info 
												.item(class="text-sm flex items-center rem:gap-[10px]" ) 
													p Xuất xứ: 
														strong Tây Ban Nha
													p Nhà sản xuất: 
														strong Uralchem 5A
											.view-detail(class="text-sm text-Primary-1 underline") 
												a(href="#") Xem thông tin chi tiết sản phẩm
								td(class="text-center")
									.product-quantity
										.quantity(class="inline-flex justify-centerw items-center rem:h-[44px]") 
											button.minus(class="inline-flex  items-center justify-center ") 
												i.fa-solid.fa-minus
											.quantity-input(class="rem:w-[44px] h-full") 
												input(type="text" value="1" class="w-full text-center bg-Neutral-White h-full  font-bold")
											button.plus(class="inline-flex  items-center justify-center ") 
												i.fa-solid.fa-plus
								td(class="text-center") 
									.price(class="flex flex-col rem:gap-[6px]") 	
										.price-sale 
											bdi(class="text-xl font-bold") 200.000 ₫
										.price-old 
											bdi(class="text-Neutral-500* text-sm line-through") 300.000 ₫
										.save(class="text-Primary-1") Tiết kiệm 20%
								td(class="text-center") 
									.total(class="text-xl font-bold")
										bdi 2.000.000 ₫
			.box-total(class="flex flex-col items-end mt-5")
				.box-total-wrapper(class="flex flex-col items-end gap-3")
					.item 
						.title Đơn giá:
						.price-unit 
							bdi 12.000.000 ₫
					.item 
						.title Tiết kiệm được:
						.price-save 
							bdi 12.000.000 ₫
					.item 
						.title Đơn giá:
						.price-total
							bdi 12.000.000 ₫
				.box-total-bottom(class="flex items-center gap-5 mt-5")
					.hotline(class="italic text-Neutral-Black")
						p Gọi ngay 
							a(href="#" class="text-Primary-7 underline") 18006022
							|  để được hỗ trợ (6:00-18:00)
					.wrap-btn(class="flex items-center gap-5")
