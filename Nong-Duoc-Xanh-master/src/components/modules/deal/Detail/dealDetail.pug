						-for(var i = 0; i < 5; i++)
							tr 														
								td(class="")
									.info-order(class="flex items-center gap-base")
										.img(class="rem:w-[130px] flex-shrink-0") 
											a(href="#" class="img-ratio") 
												+PugImg()
