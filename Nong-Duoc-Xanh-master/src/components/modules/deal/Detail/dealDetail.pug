								<i class="fa-regular fa-cart-shopping"></i>
							span Thêm vào giỏ hàng
						button.btn-add-to-cart.btn-buy-now
							.icon 
								<i class="fa-regular fa-cart-shopping"></i>
							span Mua ngay
