							p Kết thúc: 
								.date(class="text-Primary-7") 10/10/2025
					.item 
						.title Đơn hàng tối thiểu:
						.content 1.000kg/ Khách hàng
					.item 
						.title Đơn hàng tối thiểu:
						.content 1.000kg/ Khách hàng
				.deal-detail-contact(class="flex rem:gap-[43px] rem:mt-[17px]")
