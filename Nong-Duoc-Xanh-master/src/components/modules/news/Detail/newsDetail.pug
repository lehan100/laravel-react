									+PugImg()
							.content(class="flex flex-col gap-1 text-Neutral-Black")
								.position Dược sĩ Đại học
								.name(class="text-lg font-bold") Nguyễn Thị Hồng Nhung
								.wrap(class="flex items-center gap-3")
									.icon(class="text-Primary-2")
										<i class="fa-solid fa-circle-check"></i>
									span Đã kiểm duyệt nội dung
						.info-desc(class="my-5") 
							p Tốt nghiệp đại học Khoa Dược. Có kinh nghiệm hơn 10 năm trong lĩnh vực Dược phẩm, tư vấn thuốc và thực phẩm chức năng. Hiện đang là giảng viên cho Dược sĩ tại Nhà thuốc Long Châu.
						.info-social(class="flex items-center gap-5")
							a(href="#" class="sq-10 inline-flex items-center justify-center rounded-full bg-[#0039B3] text-Neutral-White") 
								<i class="fa-brands fa-facebook-f"></i>
							a(href="#" class="sq-10 inline-flex items-center justify-center rounded-full bg-[#0039B3] text-Neutral-White") 
								<i class="fa-brands fa-facebook-f"></i>
			.col-right(class="col-span-3")
				.news-list(class="flex flex-col gap-3")
					-for(var i = 0; i < 5; i++) 
						.news-wrapper(class="flex items-center gap-3")
							.img(class="rem:w-[120px]")
								a(href="#" class="img-ratio ratio:pt-[68_100] zoom-img-1 rounded-xl") 
									+PugImg()
							.content(class="flex-1")
								h2(class="rem:text-[16px] line-clamp-2 mb-1 font-bold")
									a(href="#") Hướng dẫn sử dụng thuốc bảo vệ thực vật an toàn và...
								.date(class="flex items-center gap-2")
									date(class="text-neutral-500 text-sm") 03.06.2024
									